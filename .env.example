# ==============================================================================
# ĐÂY LÀ FILE MẪU CHỨA CÁC THÔNG TIN BẢO MẬT (DOCKER ENV TEMPLATE)
# Sao chép file này thành .env và điền các giá trị thực tế
# ==============================================================================

# Cấu hình CSDL PostgreSQL (Neon.tech Cloud)
DB_PROVIDER=Postgresql
DB_CONNECTION_STRING=Host=your_postgres_host;Database=neondb;Username=neondb_owner;Password=your_postgres_password;SSL Mode=Require;Trust Server Certificate=true;

# Key mã hóa JWT token (tối thiểu 32 ký tự)
JWT_SECRET_KEY=your_very_long_secret_key_at_least_32_chars_key

# Key mã hóa HMAC
HMAC_SECRET_KEY=your_hmac_secret_key

# Khóa API kết nối dịch vụ Gemini AI
GEMINI_API_KEY=your_gemini_api_key

# Cấu hình tài khoản gửi Email (SMTP Gmail)
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# Cấu hình lưu trữ ảnh Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Cấu hình thanh toán VnPay
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
